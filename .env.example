# 动画数据同步 · 本地调试配置模板
# 说明：本文件是唯一模板，node scripts/init-env.mjs 会按它整体重写 .env。
#   - 模板中保留的键会写入 .env；已填写的值会被沿用。
#   - 模板中删掉的键，会从 .env 中直接移除，不留注释。
#   - .env 已被 .gitignore 忽略，任何脚本都不打印、不上报其中的值。

# ── 网络代理 ──────────────────────────────────────────
# 两个代理互相独立，不做继承：留空即直连。
# BGM_PROXY 只作用于 Bangumi 请求；例：http://127.0.0.1:7890
BGM_PROXY=

# ── Bangumi API ──────────────────────────────────────
BGM_BASE_URL=https://api.bgm.tv
# 官方要求带自定义 UA，缺失可能被限流或拒绝
BGM_USER_AGENT=anime-video/1.0 (dev)

# ── AI 接口（OpenAI 兼容协议）─────────────────────────
# 地址需包含版本段，脚本会在此后拼 /chat/completions
# 例：https://api.openai.com/v1 、https://api.deepseek.com/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# 只作用于 AI 请求；留空即直连，不继承 BGM_PROXY
AI_PROXY=
