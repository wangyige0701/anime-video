{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"outDir": "dist",
		"module": "esnext",
		"moduleResolution": "bundler",
		"rootDir": "..",
		"types": ["node"],

		"rewriteRelativeImportExtensions": true,
		"allowImportingTsExtensions": true
	},
	"include": [
		"./**/*.ts",
		"../shared/**/*.ts",
		"../types/**/*.d.ts",
		"clear.mjs"
	],
	"exclude": ["./test", "../node_modules", "../web", "../dev", "../test"]
}
