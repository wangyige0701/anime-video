{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"outDir": "./dist",
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"types": ["vitest/globals", "node"],
		"paths": {
			"~hls/*": ["./hls/build/*"],
			"~server/*": ["./server/*"],
			"~web/*": ["./web/*"],
			"~types/*": ["./types/*"],
			"~shared/*": ["./shared/*"]
		}
	},
	"include": ["server", "test", "dev", "test", "web", "types", "shared"],
	"exclude": ["node_modules"]
}
