{
	"extends": "@vue/tsconfig/tsconfig.dom.json",
	"include": [
		"env.d.ts",
		"src/**/*",
		"src/**/*.vue",
		"../config",
		"../types",
		"../routes",
		"auto-imports.d.ts",
		"components.d.ts",
		"typed-router.d.ts"
	],
	"exclude": ["src/**/__tests__/*"],
	"compilerOptions": {
		"lib": ["ESNext", "DOM"],
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

		"paths": {
			"@/*": ["./src/*"],
			"~config/*": ["../config/*"],
			"~routes/*": ["../routes/*"],
			"~types/*": ["../types/*"]
		}
	}
}
